{
  "llm_provider": "openai",
  "embedding_provider": "openai",

  "vector_store": {
    "type": "faiss", 
    "local": {
      "faiss_path": "vectorstores/faiss_index"
    },
    "cloud": {
      "provider": "faiss",
      "index_name": "rag-assistant-index", 
      "namespace": "default",
      "environment": "gcp-starter",
      "dimension": 1536
    }
  },

  "retriever": {
    "type": "base",
    "top_k": 3
  },
  "prompt": {
    "system_prompt": "You are a helpful and knowledgeable assistant who answers questions using uploaded documents.",
    "temperature": 0.4,
    "max_tokens": 500
  },
  "memory": {
    "enabled_default": true,
    "max_memory_window": 5
  },
  "chunking": {
    "chunk_size": 500,
    "chunk_overlap": 100
  }
}
